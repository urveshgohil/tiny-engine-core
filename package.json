{
  "name": "tiny-engine-core",
  "version": "1.8.0",
  "description": "Tiny tree-shakable core engine library",
  "type": "module",
  "main": "dist/tiny-engine.cjs",
  "module": "dist/tiny-engine.esm.js",
  "types": "dist/types/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/tiny-engine.esm.js",
      "require": "./dist/tiny-engine.cjs",
      "browser": "./dist/tiny-engine.min.js",
      "types": "./dist/types/index.d.ts"
    },
    "./data-grid": {
      "import": "./dist/data-grid/index.esm.js",
      "require": "./dist/data-grid/index.cjs",
      "types": "./dist/types/data-grid/index.d.ts"
    },
    "./data-grid/style.css": "./dist/data-grid/style.css"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/urveshgohil/tiny-engine-core.git"
  },
  "homepage": "https://tiny-engine.urveshgohil.in/",
  "scripts": {
    "build": "gulp build",
    "test:ssr": "node scripts/ssr-smoke.mjs",
    "watch": "gulp watch",
    "release": "gulp release",
    "bump-patch": "gulp bump:patch",
    "bump-minor": "gulp bump:minor",
    "bump-major": "gulp bump:major",
    "dev": "gulp",
    "demo": "node scripts/demo-server.mjs"
  },
  "keywords": [
    "tiny",
    "ui",
    "runtime",
    "engine",
    "tiny-engine",
    "Tiny engine",
    "tree-shakable",
    "Runtime core library",
    "Tiny engine core library"
  ],
  "author": "Urvesh Gohil",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^25.6.2",
    "esbuild": "^0.28.0",
    "gulp": "^5.0.1",
    "gulp-bump": "^3.2.0",
    "gulp-esbuild": "^0.14.1",
    "gulp-git": "^2.11.0",
    "typescript": "^5.9.3"
  }
}
