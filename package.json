{
  "name": "tiny-engine-core",
  "version": "1.8.0",
  "description": "Tiny tree-shakable core engine library",
  "type": "module",
  "main": "dist/tiny-engine.cjs",
  "module": "dist/tiny-engine.esm.js",
  "types": "dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "browser": "./dist/tiny-engine.min.js",
      "import": "./dist/tiny-engine.esm.js",
      "require": "./dist/tiny-engine.cjs"
    },
    "./data-grid": {
      "types": "./dist/types/data-grid/index.d.ts",
      "import": "./dist/data-grid/index.esm.js",
      "require": "./dist/data-grid/index.cjs"
    },
    "./data-grid/style.css": "./dist/data-grid/style.css"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/urveshgohil/tiny-engine-core.git"
  },
  "homepage": "https://tiny-engine.urveshgohil.in/",
  "scripts": {
    "build": "node scripts/build.mjs",
    "clean": "node scripts/build.mjs --clean",
    "typecheck": "tsc --noEmit",
    "test:ssr": "node scripts/ssr-smoke.mjs",
    "verify": "node node_modules/typescript/bin/tsc --noEmit && node scripts/build.mjs && node scripts/ssr-smoke.mjs",
    "watch": "node scripts/build.mjs --watch",
    "release": "node scripts/release.mjs",
    "bump-patch": "node scripts/version.mjs patch",
    "bump-minor": "node scripts/version.mjs minor",
    "bump-major": "node scripts/version.mjs major",
    "dev": "node scripts/build.mjs --watch",
    "demo": "node scripts/demo-server.mjs",
    "prepare": "husky"
  },
  "keywords": [
    "tiny",
    "ui",
    "runtime",
    "engine",
    "tiny-engine",
    "Tiny engine",
    "tree-shakable",
    "Runtime core library",
    "Tiny engine core library"
  ],
  "author": "Urvesh Gohil",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^26.1.1",
    "esbuild": "^0.28.0",
    "husky": "^9.1.7",
    "typescript": "^7.0.2"
  }
}
